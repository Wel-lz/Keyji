<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ ШРИФТЫ ============================ -->
    <!-- Единый хэндл встроенного Space Mono: вёрстка биндит
         `{StaticResource SpaceMono}`, не хардкодя pack://-строку по местам.
         Начертание — use-site FontWeight (лейблы/вордмарк весом 700, эмбед
         содержит реальный Bold-face того же семейства). Georgia — системный,
         ресурс не нужен, задаётся напрямую FontFamily="Georgia". -->
    <FontFamily x:Key="SpaceMono">pack://application:,,,/Assets/Fonts/#Space Mono</FontFamily>

    <!-- Иконки кастомной панели. Все геометрии в системе координат
         viewBox 0 0 24 24 — как в исходных SVG.

         РАЗДЕЛЕНИЕ ОТВЕТСТВЕННОСТИ: этот файл задаёт форму + режим рендера
         (fill vs stroke), нейтрально к теме; цвет владеет тема панели (кисть
         `PanelIconBrush`, light/dark); применение стиля к Path и точечные
         переопределения Fill/Stroke per-instance (icon/icon2/accent/danger) —
         на стороне вёрстки панели.

         РЕЖИМ РЕНДЕРА — НЕ выводить заново, он закодирован стилем:
           • FILL   иконки {Pin, Kebab, Moon}          → стиль PanelIcon.Fill
           • STROKE иконки {Sun, Download, Gear, Exit}  → стиль PanelIcon.Stroke
             (Feather-контуры: fill=none, stroke-width=2, round cap/join; залитые
              сплошным без учёта режима превратятся в чёрные кляксы — это нужно
              не потерять при последующей стилизации).
         x:Shared="False" — одна геометрия переиспользуется в нескольких строках панели. -->

    <!-- ============================ ЛОГОТИП ============================ -->
    <!-- Логотип шапки панели — перевод `img/keyji-on.svg` (полноразмерный знак),
         а НЕ трей-иконки: `TrayIcons.xaml` держит упрощённый глиф из
         `img/keyji-16-*.svg`, срисованный под 16px, и в шапке 44×44 он читается
         как обрубок. Плашка и кремовый уголок у обоих общие — различается только
         глиф (здесь полный росчерк, transform translate(141,140) scale(2.7)).

         Внешний тёмный квадрат 512×512 из SVG сознательно не переносим:
         логотип сидит на поверхности карты, своя подложка ему не нужна. -->
    <DrawingImage x:Key="PanelLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.ClipGeometry>
                    <RectangleGeometry Rect="104,104,304,304" RadiusX="60" RadiusY="60" />
                </DrawingGroup.ClipGeometry>
                <!-- Зазор между плашкой и уголком оставлен ПУСТЫМ, а не залитым тёмным
                     фоном из SVG: тёмная подложка держится только на тёмной карте, а на
                     светлой теме читается как грязный контур вокруг знака. Прозрачный
                     зазор показывает поверхность карты и работает в обеих темах. -->
                <!-- Плашка — пятиугольник со срезанным нижним-правым углом (НЕ полный
                     прямоугольник): срез идёт по 408,266 → 266,408, а уголок начинается
                     только с 310,408 — между ними остаётся диагональный зазор, часть знака. -->
                <GeometryDrawing Geometry="M104,104 L408,104 L408,266 L266,408 L104,408 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="120,120" EndPoint="392,392" MappingMode="Absolute">
                            <GradientStop Offset="0" Color="#F6B23E" />
                            <GradientStop Offset="1" Color="#D9660C" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Brush="#EAE9E4" Geometry="M310,408 L408,310 L408,408 Z" />
                <GeometryDrawing Brush="#16130F">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 14.8 83.8 L 8 71.5 Q 15.2 69.9 23.05 66.45 Q 30.9 63 38.7 58.35 Q 46.5 53.7 53.6 48.35 Q 60.7 43 66.4 37.55 Q 72.1 32.1 75.7 27.1 Q 76.1 28.9 77.05 31.4 Q 78 33.9 79.1 36.2 Q 80.2 38.5 81 39.8 Q 76 46.1 68.65 52.5 Q 61.3 58.9 52.5 64.85 Q 43.7 70.8 34.05 75.7 Q 24.4 80.6 14.8 83.8 Z M 40.7 20.9 L 33.4 30.7 Q 32.2 29.5 29.75 27.8 Q 27.3 26.1 24.35 24.25 Q 21.4 22.4 18.75 20.9 Q 16.1 19.4 14.4 18.7 L 21.2 8.3 Q 23.2 9.3 25.95 11 Q 28.7 12.7 31.55 14.55 Q 34.4 16.4 36.85 18.1 Q 39.3 19.8 40.7 20.9 Z M 26.1 40.8 L 19.6 51.4 Q 17.7 49.8 14.05 47.8 Q 10.4 45.8 6.55 43.95 Q 2.7 42.1 0 41.2 L 6.2 30.4 Q 9.1 31.5 12.95 33.4 Q 16.8 35.3 20.4 37.3 Q 24 39.3 26.1 40.8 Z M 71.8 19.6 L 66.4 24.5 Q 64.3 21.5 61 18.1 Q 57.7 14.7 55.1 12.7 L 60.2 7.9 Q 61.7 9.1 63.95 11.3 Q 66.2 13.5 68.4 15.75 Q 70.6 18 71.8 19.6 Z M 80.3 11.5 L 74.9 16.4 Q 72.8 13.5 69.45 10.1 Q 66.1 6.7 63.5 4.8 L 68.6 0 Q 70.2 1.1 72.45 3.25 Q 74.7 5.4 76.9 7.65 Q 79.1 9.9 80.3 11.5 Z">
                            <PathGeometry.Transform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="2.7" ScaleY="2.7" />
                                    <TranslateTransform X="141" Y="140" />
                                </TransformGroup>
                            </PathGeometry.Transform>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ============================ FILL ============================ -->

    <!-- Pin (accent) — закреплённый язык. -->
    <PathGeometry x:Key="Icon.Pin.Geometry" x:Shared="False"
                  Figures="M22.314 10.172l-1.415 1.414-.707-.707-4.242 4.242-.707 3.536-1.415 1.414-4.242-4.243-4.95 4.95-1.414-1.414 4.95-4.95-4.243-4.242 1.414-1.415L8.88 8.05l4.242-4.242-.707-.707 1.414-1.415z" />

    <!-- Kebab «…» — кнопка меню строки (три точки). -->
    <GeometryGroup x:Key="Icon.Kebab.Geometry" x:Shared="False">
        <EllipseGeometry Center="5,12"  RadiusX="2" RadiusY="2" />
        <EllipseGeometry Center="12,12" RadiusX="2" RadiusY="2" />
        <EllipseGeometry Center="19,12" RadiusX="2" RadiusY="2" />
    </GeometryGroup>

    <!-- Moon — переключатель темы (тёмная активна). -->
    <PathGeometry x:Key="Icon.Moon.Geometry" x:Shared="False"
                  Figures="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />

    <!-- =========================== STROKE =========================== -->

    <!-- Sun — переключатель темы (светлая активна). -->
    <GeometryGroup x:Key="Icon.Sun.Geometry" x:Shared="False">
        <EllipseGeometry Center="12,12" RadiusX="5" RadiusY="5" />
        <LineGeometry StartPoint="12,1"     EndPoint="12,3" />
        <LineGeometry StartPoint="12,21"    EndPoint="12,23" />
        <LineGeometry StartPoint="4.22,4.22"   EndPoint="5.64,5.64" />
        <LineGeometry StartPoint="18.36,18.36" EndPoint="19.78,19.78" />
        <LineGeometry StartPoint="1,12"     EndPoint="3,12" />
        <LineGeometry StartPoint="21,12"    EndPoint="23,12" />
        <LineGeometry StartPoint="4.22,19.78"  EndPoint="5.64,18.36" />
        <LineGeometry StartPoint="18.36,5.64"  EndPoint="19.78,4.22" />
    </GeometryGroup>

    <!-- Download — скачать нерегистрированную раскладку. -->
    <PathGeometry x:Key="Icon.Download.Geometry" x:Shared="False"
                  Figures="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10 12 15 17 10M12 15 12 3" />

    <!-- Gear — настройки (шестерёнка в футере). -->
    <GeometryGroup x:Key="Icon.Gear.Geometry" x:Shared="False">
        <EllipseGeometry Center="12,12" RadiusX="3" RadiusY="3" />
        <PathGeometry Figures="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
    </GeometryGroup>

    <!-- Exit — выход из приложения (log-out, danger). -->
    <PathGeometry x:Key="Icon.Exit.Geometry" x:Shared="False"
                  Figures="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17 21 12 16 7M21 12 9 12" />

    <!-- ==================== СТИЛИ РЕЖИМА РЕНДЕРА ==================== -->
    <!-- Цвет по умолчанию — DynamicResource PanelIconBrush (определяет тема панели).
         Вёрстка может переопределить Fill/Stroke локально на конкретной строке. -->

    <Style x:Key="PanelIcon.Fill" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{DynamicResource PanelIconBrush}" />
    </Style>

    <Style x:Key="PanelIcon.Stroke" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource PanelIconBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

</ResourceDictionary>
