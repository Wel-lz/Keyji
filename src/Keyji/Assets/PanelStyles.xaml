<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Стили-примитивы кастомной панели. Метрики (радиусы, размеры,
         длительности переходов) — по макету дизайна;
         цвета — из словарей тем и ТОЛЬКО через DynamicResource: панель обязана
         переживать свап темы на лету (StaticResource заморозит кисть).

         Живут отдельным словарём, а не в Window.Resources, потому что «…»-оверлей
         строки переиспользует те же кнопки-иконки. -->

    <!-- ==================== КНОПКИ-ИКОНКИ ==================== -->
    <!-- Радиус разный по месту (kebab/download 8, тема 10, футер — нижние
         углы карты 22), поэтому шаблон повторяется: у Button нет CornerRadius,
         который можно было бы прокинуть TemplateBinding'ом. -->

    <!-- Кебаб «…» и «⤓ скачать» внутри строки языка: 34×34, радиус 8. -->
    <Style x:Key="Panel.IconButton" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Широкая строка-кнопка во всю ширину карты («+ добавить язык»). -->
    <Style x:Key="Panel.RowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Строка-кнопка каталога: как Panel.RowButton, но ContentPresenter тянется
         на всю ширину (Stretch), иначе Grid строки сжимается по содержимому и правый блок
         («+»/«скачать») встаёт у конца текста, а не флешем вправо — «криво» на разной длине
         лейблов. Отдельный стиль, чтобы не трогать «+ добавить язык» (там Left уместен). -->
    <Style x:Key="Panel.CatalogRowButton" TargetType="Button" BasedOn="{StaticResource Panel.RowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопки футера: скругление наследует нижние углы карты (22), поэтому левая и
         правая отличаются — общего шаблона у них не выходит. -->
    <Style x:Key="Panel.FooterLeftButton" TargetType="Button" BasedOn="{StaticResource Panel.RowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,0,0,22">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Panel.FooterRightButton" TargetType="Button" BasedOn="{StaticResource Panel.RowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0,0,22,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== ПУНКТ «…»-МЕНЮ СТРОКИ ==================== -->
    <!-- Space Mono 13px, padding 10/12, радиус 7, hover-подсветка; ширина тянется
         на весь поповер (текст слева), поэтому не IconButton, а своя кнопка. -->
    <Style x:Key="Panel.MenuItem" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="12,10">
                        <!-- Stretch (а не Left): пункт тянется на всю ширину меню, чтобы
                             галочка чекаемого пункта прижималась к правому краю. -->
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== КНОПКИ CONFIRM-ДИАЛОГА ==================== -->
    <!-- Ghost-стиль без заливки (тема-безопасно): primary красится акцентом,
         secondary — приглушённым; hover даёт лёгкую подсветку. -->
    <Style x:Key="Panel.DialogButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource SpaceMono}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="16,10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Panel.DialogPrimary" TargetType="Button" BasedOn="{StaticResource Panel.DialogButton}">
        <Setter Property="Foreground" Value="{DynamicResource PanelAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
    </Style>

    <Style x:Key="Panel.DialogGhost" TargetType="Button" BasedOn="{StaticResource Panel.DialogButton}">
        <Setter Property="Foreground" Value="{DynamicResource PanelMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderStrongBrush}" />
    </Style>

    <!-- ==================== ТИПОГРАФИКА ==================== -->

    <!-- Нативный эндоним языка: системный гротеск без засечек (Segoe UI), 25px.
         Замена Georgia на sans: Segoe UI не вшивается и
         покрывает CJK/арабицу/кириллицу через системный фолбэк шрифтов. -->
    <Style x:Key="Panel.NativeName" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="Foreground" Value="{DynamicResource PanelTextBrush}" />
    </Style>

    <!-- Локализованное имя от ОС: Space Mono 700, 12px, трекинг 1.5. -->
    <Style x:Key="Panel.NameLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SpaceMono}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PanelMutedBrush}" />
    </Style>

    <!-- ==================== ТОГЛ ВКЛ/ВЫКЛ ==================== -->
    <!-- Пилюля 62×34 с ручкой 26. Переход фона трека сделан наложением двух слоёв
         (accent снизу, track-off сверху с анимируемой Opacity): анимировать цвет
         кисти напрямую нельзя — кисти приходят DynamicResource'ом из темы. -->
    <Style x:Key="Panel.Toggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="62" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border CornerRadius="17" Background="{DynamicResource PanelAccentBrush}" />
                        <Border x:Name="TrackOff" CornerRadius="17"
                                Background="{DynamicResource PanelTrackOffBrush}" Opacity="1" />
                        <Ellipse x:Name="Knob" Width="26" Height="26"
                                 HorizontalAlignment="Left" Margin="4,0,0,0"
                                 Fill="{DynamicResource PanelKnobOffBrush}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource PanelKnobOnBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="28" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TrackOff"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TrackOff"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== ЧЕКБОКС АВТОЗАПУСКА ==================== -->
    <!-- Квадрат 18×18 радиуса 5 с заливкой accent, а НЕ ToggleSwitch —
         инлайн-настройка не должна выглядеть как тогл языка. -->
    <Style x:Key="Panel.CheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                            Background="Transparent"
                            BorderBrush="{DynamicResource PanelBorderStrongBrush}" BorderThickness="1">
                        <Path x:Name="Check" Visibility="Collapsed"
                              Width="10" Height="10" Stretch="Uniform"
                              Data="M4 12 9 17 20 6"
                              Stroke="{DynamicResource PanelSurfaceBrush}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource PanelAccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== СЕГМЕНТ-КОНТРОЛ ТЕМЫ ====================
         Тристейт «Системная · Светлая · Тёмная»: три
         RadioButton в общей группе живут в контейнере-треке (ниже, в разметке оверлея).
         Выбранный сегмент заливается accent'ом, текст на нём — цветом поверхности (контраст,
         как галочка чекбокса); прочие приглушены. Space Mono, скругление 8 — вписывается
         в трек радиуса 10 с полем 3. Триггер IsChecked стоит после IsMouseOver, поэтому
         выбранный сегмент держит accent и под курсором. -->
    <Style x:Key="Panel.Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource SpaceMono}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource PanelMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Seg" Background="Transparent" CornerRadius="8" Padding="0,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{DynamicResource PanelAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PanelSurfaceBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== ДРОПДАУН ЯЗЫКА ====================
         Themed-ComboBox под kj-токены (дефолтный WPF-вид чужероден и в светлой теме сливался).
         Подтверждено: раскрытие Popup композится над оверлеем в HWND. Бокс —
         ToggleButton (заливка + стрелка), выбранное значение поверх через ContentPresenter
         (IsHitTestVisible=False); список — Popup PART_Popup в теме панели (как ConfirmLayer),
         пункты — Panel.ComboItem. Space Mono, скругление 8. -->
    <Style x:Key="Panel.ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource SpaceMono}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource PanelMenuTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <!-- Левый отступ 14 = отступ текста бокса: выбранный пункт в списке встаёт
                         ровно под значением в боксе (иначе список «криво» смещён). -->
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="14,9">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- IsHighlighted покрывает и мышь, и клавиатурную навигацию. -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PanelAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Panel.ComboBox" TargetType="ComboBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource SpaceMono}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource PanelTextBrush}" />
        <!-- Тянемся на всю ширину карточки (как сегмент темы выше): без этого бокс
             сжимается по содержимому и выглядит «криво» узким. -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Panel.ComboItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Бокс: клик открывает/закрывает список (IsChecked ↔ IsDropDownOpen).
                             Style={x:Null} глушит неявный стиль ToggleButton от WPF-UI
                             (ui:ControlsDictionary в App.xaml) — иначе он навязывал бокс сжатым. -->
                        <ToggleButton x:Name="Toggle" Style="{x:Null}" Focusable="False" ClickMode="Press"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <!-- Вертикальный padding подобран так, чтобы высота бокса
                                         совпала с сегментом темы выше (~единый вид настроек). -->
                                    <Border x:Name="Box" CornerRadius="8" Padding="14,13"
                                            Background="{DynamicResource PanelMenuBackgroundBrush}"
                                            BorderBrush="{DynamicResource PanelBorderStrongBrush}" BorderThickness="1">
                                        <!-- Стрелка справа; выбранное значение рисует ContentPresenter уровнем выше. -->
                                        <Path HorizontalAlignment="Right" Data="M6 9 12 15 18 9" Stretch="Uniform"
                                              Stroke="{DynamicResource PanelIcon2Brush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="12" Height="8" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Выбранное значение поверх бокса; клики проходят сквозь к ToggleButton. -->
                        <ContentPresenter IsHitTestVisible="False" Margin="14,0,38,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                        <!-- Список: слой Popup в теме панели (тень как у ConfirmLayer). Ширина
                             прибита к боксу (Min=Max=ActualWidth бокса), левый край флешем под
                             боксом (Placement=Bottom). Горизонтального padding у рамки нет —
                             пункты сами держат отступ 14, выравниваясь с текстом бокса. -->
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               PlacementTarget="{Binding ElementName=Toggle}"
                               PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}"
                                    MaxWidth="{Binding ActualWidth, ElementName=Toggle}"
                                    UseLayoutRounding="True"
                                    Margin="0,6,0,0" CornerRadius="10" Padding="0,5"
                                    Background="{DynamicResource PanelMenuBackgroundBrush}"
                                    BorderBrush="{DynamicResource PanelBorderStrongBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="32" ShadowDepth="12" Direction="270"
                                                      Opacity="0.6" Color="{DynamicResource PanelMenuShadowColor}" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
