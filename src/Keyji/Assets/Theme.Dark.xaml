<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ТЁМНАЯ тема панели. Перенос 1:1 CSS-токенов `kj-*` — селектор `.kj-win`.

         ПАРНОСТЬ: набор ключей ЗДЕСЬ И В Theme.Light.xaml обязан совпадать один-в-один —
         свап словаря на лету (PanelTheme) меняет только значения; ключ, живущий лишь в
         одной теме, при свапе разрешится в старое значение или упадёт в рантайме.

         ПОТРЕБЛЕНИЕ: только через `DynamicResource` — `StaticResource` замораживает
         кисть на момент загрузки XAML и переживёт свап темы неперекрашенным.

         ВЛАДЕНИЕ: эта тема владеет цветом. Геометрия/режим рендера иконок —
         `PanelIcons.xaml`, метрики (радиусы, размеры, типографика) — вёрстка панели. -->

    <!-- ====================== ПОВЕРХНОСТИ ====================== -->

    <!-- kj-page: фон окна за карточкой. -->
    <SolidColorBrush x:Key="PanelPageBrush" Color="#100D0A" />
    <!-- kj-surface: фон самой карточки-панели. -->
    <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#211D18" />
    <!-- kj-pinned-bg: подложка блока закреплённого языка. rgba(235,154,46,0.05) -->
    <SolidColorBrush x:Key="PanelPinnedBackgroundBrush" Color="#0DEB9A2E" />
    <!-- kj-menu-bg: фон «…»-оверлея. -->
    <SolidColorBrush x:Key="PanelMenuBackgroundBrush" Color="#2B261F" />
    <!-- kj-inset: объявлен, но не применён — задел под инсет-поверхности.
         Держим ради парности ключей, чтобы вёрстка могла взять его без правки обеих тем. -->
    <SolidColorBrush x:Key="PanelInsetBrush" Color="#05FFFFFF" />

    <!-- ====================== ГРАНИЦЫ И HOVER ====================== -->

    <!-- kj-border: разделители строк, верх футера. rgba(255,255,255,0.07) -->
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#12FFFFFF" />
    <!-- kj-border-strong: рамка «…»-меню, бейдж «СИСТЕМНЫЙ», выключенный чекбокс. -->
    <SolidColorBrush x:Key="PanelBorderStrongBrush" Color="#1FFFFFFF" />
    <!-- kj-hover: подсветка наведения. rgba(255,255,255,0.06) -->
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#0FFFFFFF" />

    <!-- ====================== ТЕКСТ ====================== -->

    <!-- kj-text: нативное имя языка (Georgia) в управляемых строках. -->
    <SolidColorBrush x:Key="PanelTextBrush" Color="#F2ECE2" />
    <!-- kj-text-dim: то же имя в секции системных языков. -->
    <SolidColorBrush x:Key="PanelTextDimBrush" Color="#CFC7BA" />
    <!-- kj-muted: Space Mono-лейбл языка, текст бейджа «СИСТЕМНЫЙ». -->
    <SolidColorBrush x:Key="PanelMutedBrush" Color="#7D7568" />
    <!-- kj-label: лейбл в секции системных языков (ещё приглушённее). -->
    <SolidColorBrush x:Key="PanelLabelBrush" Color="#6A6357" />
    <!-- kj-menu-text: пункты «…»-меню. -->
    <SolidColorBrush x:Key="PanelMenuTextBrush" Color="#E4DDD1" />

    <!-- ====================== АКЦЕНТ И СТАТУСЫ ====================== -->

    <!-- kj-accent: вордмарк «keyji_», pin, «+ добавить язык», включённый тогл/чекбокс. -->
    <SolidColorBrush x:Key="PanelAccentBrush" Color="#EB9A2E" />
    <!-- kj-danger: «Выход», деструктивные пункты (в т.ч. «Убрать из набора»). -->
    <SolidColorBrush x:Key="PanelDangerBrush" Color="#D98A6A" />

    <!-- ====================== ИКОНКИ ====================== -->

    <!-- kj-icon: цвет по умолчанию для стилей `PanelIcon.Fill`/`PanelIcon.Stroke`
         из PanelIcons.xaml — прежде всего кебаб «…».
         Значение одинаково в обеих темах; ключ всё равно живёт в теме,
         потому что владелец цвета — тема и потребитель биндится DynamicResource. -->
    <SolidColorBrush x:Key="PanelIconBrush" Color="#8A8275" />
    <!-- kj-icon2: иконки шапки/футера — тема-тогл, скачивание, шестерёнка. -->
    <SolidColorBrush x:Key="PanelIcon2Brush" Color="#B9B0A2" />

    <!-- ====================== ТОГЛ ВКЛ/ВЫКЛ ====================== -->

    <!-- kj-track-off: трек выключенного тогла (включённый = PanelAccentBrush). -->
    <SolidColorBrush x:Key="PanelTrackOffBrush" Color="#3A352D" />
    <!-- kj-knob-off / kj-knob-on: ручка тогла по состоянию. -->
    <SolidColorBrush x:Key="PanelKnobOffBrush" Color="#F7F5F0" />
    <SolidColorBrush x:Key="PanelKnobOnBrush" Color="#100D0A" />

    <!-- ====================== ТЕНИ ====================== -->

    <!-- Не токены: заданы литералами внутри box-shadow и НЕ различаются между
         темами. Живут в словаре темы, потому что `DropShadowEffect.Color` требует Color,
         а тень по светлой карточке — первый кандидат на расхождение при полировке. -->
    <Color x:Key="PanelShadowColor">#B3000000</Color>
    <Color x:Key="PanelMenuShadowColor">#99000000</Color>

</ResourceDictionary>
